{
  "name": "linuxdo-guest-browser",
  "displayName": "LINUX DO 游客阅读器",
  "description": "在 VS Code 中以游客身份浏览 LINUX DO 的公开内容。",
  "version": "0.15.1",
  "publisher": "lexiao-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leisure-Xr/chas.git",
    "directory": "linuxdo-guest-browser/vscode"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "linux.do",
    "linuxdo",
    "discourse",
    "reader"
  ],
  "activationEvents": [
    "onView:linuxdoGuest.explorer",
    "onCommand:linuxdoGuest.open",
    "onCommand:linuxdoGuest.openLatest",
    "onCommand:linuxdoGuest.openTop",
    "onCommand:linuxdoGuest.openCategories",
    "onCommand:linuxdoGuest.setCloudflareClearance",
    "onCommand:linuxdoGuest.clearCloudflareClearance",
    "onCommand:linuxdoGuest.setRequestMode",
    "onCommand:linuxdoGuest.shareCurrentTopic",
    "onCommand:linuxdoGuest.openShareCode",
    "onCommand:linuxdoGuest.shareHelp"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "linuxdoGuest.open",
        "title": "LINUX DO: 打开游客阅读器",
        "icon": "$(globe)"
      },
      {
        "command": "linuxdoGuest.openLatest",
        "title": "LINUX DO: 最新主题",
        "icon": "$(clock)"
      },
      {
        "command": "linuxdoGuest.openTop",
        "title": "LINUX DO: 热门主题",
        "icon": "$(flame)"
      },
      {
        "command": "linuxdoGuest.openCategories",
        "title": "LINUX DO: 分类",
        "icon": "$(list-tree)"
      },
      {
        "command": "linuxdoGuest.refresh",
        "title": "刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "linuxdoGuest.setCloudflareClearance",
        "title": "LINUX DO: 设置 Cloudflare 验证",
        "icon": "$(verified)"
      },
      {
        "command": "linuxdoGuest.clearCloudflareClearance",
        "title": "LINUX DO: 清除 Cloudflare 验证",
        "icon": "$(trash)"
      },
      {
        "command": "linuxdoGuest.setRequestMode",
        "title": "LINUX DO: 设置请求节奏",
        "icon": "$(dashboard)"
      },
      {
        "command": "linuxdoGuest.shareCurrentTopic",
        "title": "LINUX DO: 分享当前主题",
        "icon": "$(share)"
      },
      {
        "command": "linuxdoGuest.openShareCode",
        "title": "LINUX DO: 打开加密分享",
        "icon": "$(link-external)"
      },
      {
        "command": "linuxdoGuest.shareHelp",
        "title": "LINUX DO: 加密分享使用说明",
        "icon": "$(question)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "linuxdoGuest",
          "title": "LINUX DO",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "linuxdoGuest": [
        {
          "id": "linuxdoGuest.explorer",
          "name": "游客阅读",
          "icon": "media/activity.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "linuxdoGuest.open",
          "when": "view == linuxdoGuest.explorer",
          "group": "navigation@1"
        },
        {
          "command": "linuxdoGuest.refresh",
          "when": "view == linuxdoGuest.explorer",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "LINUX DO 游客阅读器",
      "properties": {
        "linuxdoGuest.defaultView": {
          "type": "string",
          "enum": [
            "latest",
            "top",
            "categories"
          ],
          "enumDescriptions": [
            "最新主题",
            "热门主题",
            "分类列表"
          ],
          "default": "latest",
          "description": "打开阅读器时默认显示的页面。"
        },
        "linuxdoGuest.requestMode": {
          "type": "string",
          "enum": [
            "smart",
            "fluent",
            "balanced",
            "careful"
          ],
          "enumDescriptions": [
            "根据明确限流自动在均衡、稳妥和流畅之间调整。",
            "令牌容量 2，每 4 秒平滑恢复 1 次。",
            "令牌容量 2，每 5 秒平滑恢复 1 次。",
            "令牌容量 1，每 8 秒平滑恢复 1 次。"
          ],
          "default": "smart",
          "description": "控制游客公开接口的请求节奏；仍会遵守站点返回的 Retry-After。"
        },
        "linuxdoGuest.breakReminder.enabled": {
          "type": "boolean",
          "default": false,
          "description": "开启后，在阅读器运行期间每隔随机 31–60 分钟提醒休息，并可进入五个内置小游戏。"
        }
      }
    }
  },
  "scripts": {
    "check": "bash ../shared/check-game-core.sh && bash ../shared/check-game-ui.sh && node --check src/extension.js && node --check src/guest-session.js && node --check src/request-profile.js && node --check src/reader-history.js && node --check src/share-code.js && node --check src/verification-panel.js && node --check media/game-core.js && node --check media/game-ui.js && node --check media/main.js && npm test",
    "test": "node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce@3.6.0 package --no-dependencies"
  }
}
