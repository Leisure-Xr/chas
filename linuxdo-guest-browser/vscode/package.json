{
  "name": "linuxdo-guest-browser",
  "displayName": "LINUX DO 游客阅读器",
  "description": "在 VS Code 中以游客身份浏览 LINUX DO 的公开内容。",
  "version": "0.19.0",
  "publisher": "lexiao-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leisure-Xr/chas.git",
    "directory": "linuxdo-guest-browser/vscode"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "linux.do",
    "linuxdo",
    "discourse",
    "reader"
  ],
  "activationEvents": [
    "onView:linuxdoGuest.explorer",
    "onCommand:linuxdoGuest.open",
    "onCommand:linuxdoGuest.openLatest",
    "onCommand:linuxdoGuest.openTop",
    "onCommand:linuxdoGuest.openCategories",
    "onCommand:linuxdoGuest.setCloudflareClearance",
    "onCommand:linuxdoGuest.clearCloudflareClearance",
    "onCommand:linuxdoGuest.setRequestMode",
    "onCommand:linuxdoGuest.setRequestEngine",
    "onCommand:linuxdoGuest.openNativeVerification",
    "onCommand:linuxdoGuest.shareCurrentTopic",
    "onCommand:linuxdoGuest.openShareCode",
    "onCommand:linuxdoGuest.shareHelp"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "linuxdoGuest.open",
        "title": "LINUX DO: 打开游客阅读器",
        "icon": "$(globe)"
      },
      {
        "command": "linuxdoGuest.openLatest",
        "title": "LINUX DO: 最新主题",
        "icon": "$(clock)"
      },
      {
        "command": "linuxdoGuest.openTop",
        "title": "LINUX DO: 热门主题",
        "icon": "$(flame)"
      },
      {
        "command": "linuxdoGuest.openCategories",
        "title": "LINUX DO: 分类",
        "icon": "$(list-tree)"
      },
      {
        "command": "linuxdoGuest.refresh",
        "title": "刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "linuxdoGuest.setCloudflareClearance",
        "title": "LINUX DO: 设置 Cloudflare 验证",
        "icon": "$(verified)"
      },
      {
        "command": "linuxdoGuest.clearCloudflareClearance",
        "title": "LINUX DO: 清除 Cloudflare 验证",
        "icon": "$(trash)"
      },
      {
        "command": "linuxdoGuest.setRequestMode",
        "title": "LINUX DO: 设置请求节奏",
        "icon": "$(dashboard)"
      },
      {
        "command": "linuxdoGuest.setRequestEngine",
        "title": "LINUX DO: 设置请求引擎",
        "icon": "$(server-process)"
      },
      {
        "command": "linuxdoGuest.openNativeVerification",
        "title": "LINUX DO: 打开原生游客验证",
        "icon": "$(browser)"
      },
      {
        "command": "linuxdoGuest.shareCurrentTopic",
        "title": "LINUX DO: 分享当前主题",
        "icon": "$(share)"
      },
      {
        "command": "linuxdoGuest.openShareCode",
        "title": "LINUX DO: 打开加密分享",
        "icon": "$(link-external)"
      },
      {
        "command": "linuxdoGuest.shareHelp",
        "title": "LINUX DO: 加密分享使用说明",
        "icon": "$(question)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "linuxdoGuest",
          "title": "LINUX DO",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "linuxdoGuest": [
        {
          "id": "linuxdoGuest.explorer",
          "name": "游客阅读",
          "icon": "media/activity.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "linuxdoGuest.open",
          "when": "view == linuxdoGuest.explorer",
          "group": "navigation@1"
        },
        {
          "command": "linuxdoGuest.refresh",
          "when": "view == linuxdoGuest.explorer",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "LINUX DO 游客阅读器",
      "properties": {
        "linuxdoGuest.defaultView": {
          "type": "string",
          "enum": [
            "latest",
            "top",
            "categories"
          ],
          "enumDescriptions": [
            "最新主题",
            "热门主题",
            "分类列表"
          ],
          "default": "latest",
          "description": "打开阅读器时默认显示的页面。"
        },
        "linuxdoGuest.requestMode": {
          "type": "string",
          "enum": [
            "smart",
            "fluent",
            "balanced",
            "careful"
          ],
          "enumDescriptions": [
            "根据明确限流自动在均衡、稳妥和流畅之间调整。",
            "令牌容量 2，每 4 秒平滑恢复 1 次。",
            "令牌容量 2，每 5 秒平滑恢复 1 次。",
            "令牌容量 1，每 8 秒平滑恢复 1 次。"
          ],
          "default": "smart",
          "description": "控制游客公开接口的请求节奏；仍会遵守站点返回的 Retry-After。"
        },
        "linuxdoGuest.requestEngine": {
          "type": "string",
          "enum": [
            "auto",
            "native",
            "manual"
          ],
          "enumDescriptions": [
            "新版桌面 VS Code 优先使用内置原生浏览器；不可用时回退到手动参数。",
            "只使用 VS Code Integrated Browser，Cloudflare 和公开接口保持同一 Chromium 会话。",
            "使用已保存的 Cookie、User-Agent 和 Node 请求。"
          ],
          "default": "auto",
          "description": "选择游客公开接口使用的请求引擎。原生模式会创建专用 ephemeral 浏览器标签。"
        },
        "linuxdoGuest.persistContentCache": {
          "type": "boolean",
          "default": true,
          "description": "把已读页面的公开 JSON 缓存写入插件存储目录（最多 80 条 / 4 MB，保留 6 小时）。重启后仍能在站点限流时直接显示上次内容，而不是整页报错。关闭后立即删除已写入的缓存文件。"
        },
        "linuxdoGuest.breakReminder.enabled": {
          "type": "boolean",
          "default": false,
          "description": "开启后，在阅读器运行期间每隔随机 31–60 分钟提醒休息，并可进入五个内置小游戏。"
        },
        "linuxdoGuest.showAvatars": {
          "type": "boolean",
          "default": false,
          "description": "显示用户头像。关闭时使用首字母色块，一页列表可少发几十个不受节奏控制的图片请求，显著降低被限流的概率。"
        },
        "linuxdoGuest.postImages": {
          "type": "string",
          "enum": [
            "proxy",
            "off"
          ],
          "enumDescriptions": [
            "由扩展代理帖子正文图片：统一限速、带游客参数并在内存中缓存。",
            "完全不加载帖子正文图片。"
          ],
          "default": "proxy",
          "description": "选择帖子正文图片的加载方式。代理模式只在图片滚动进入视口时请求。"
        },
        "linuxdoGuest.nativeIdleReleaseMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "原生浏览器引擎空闲多少分钟后自动释放标签页与调试连接（0 表示不释放）。释放后下次请求会自动重连，但需要重新完成一次 Cloudflare 验证。"
        }
      }
    }
  },
  "scripts": {
    "check": "bash ../shared/check-game-core.sh && bash ../shared/check-game-ui.sh && node --check src/extension.js && node --check src/guest-session.js && node --check src/native-browser-session.js && node --check src/image-proxy.js && node --check src/content-cache.js && node --check src/request-profile.js && node --check src/reader-history.js && node --check src/favorites.js && node --check src/share-code.js && node --check src/verification-panel.js && node --check media/game-core.js && node --check media/game-ui.js && node --check media/main.js && npm test",
    "test": "node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce@3.6.0 package --no-dependencies"
  }
}
