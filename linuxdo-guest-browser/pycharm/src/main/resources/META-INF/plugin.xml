<idea-plugin>
    <id>studio.lexiao.linuxdo.guestbrowser</id>
    <name>论坛游客阅读器</name>
    <vendor email="support@lexiao.studio">LeXiao Studio</vendor>

    <description><![CDATA[
      在 PyCharm 中以游客身份阅读 LINUX DO、NodeSeek、V2EX 和 IDCFlare 的公开内容，可在“⋯”菜单中切换论坛。
      默认使用跟随 IDE 主题、正文图片之外全单色的隐私阅读布局，不添加伪代码装饰。插件不会请求、保存或提交账号凭据，
      会阻止登录页面，并在游客阅读会话开始和结束时清理这些论坛的 Cookie。
    ]]></description>

    <version>16.1</version>
    <idea-version since-build="223" until-build="263.*"/>
    <depends>com.intellij.modules.platform</depends>
    <resource-bundle>messages.ForumReaderBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="LINUX DO"
                    anchor="right"
                    factoryClass="studio.lexiao.linuxdo.LinuxDoToolWindowFactory"
                    canCloseContents="false"/>
    </extensions>
</idea-plugin>
